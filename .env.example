# Copy to .env and adjust. Every value has a safe default for local development.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

POSTGRES_DB=finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard

DEMO_USER_PASSWORD=finguard123

# Scorer: auto (trained model if present, else rules) | rules | xgboost
SCORER=auto
# Optional override of the model's tuned threshold
# FLAG_THRESHOLD=0.5

# Transaction simulator
SIM_TPS=5
SIM_CUSTOMERS=5000
SIM_FRAUD_RATE=0.01

# ---- AI service (LLM agent + natural-language analytics) ----
# Free Groq key: https://console.groq.com/keys  — leave empty for offline (template) mode
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
# Local, no sign-up alternative (Ollama running on your Mac):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
# LLM_FAST_MODEL=llama3.1

AUTO_INVESTIGATE_PRIORITIES=HIGH
AUTO_INVESTIGATE_DAILY_TOKENS=100000

# Service-to-service secret and read-only DB role password — change in production
AI_SERVICE_TOKEN=dev-service-token
READONLY_DB_PASSWORD=finguard_ro
